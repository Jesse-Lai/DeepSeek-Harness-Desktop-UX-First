{
  "name": "deepseek-harness-desktop",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "A polished, ready-to-run desktop experience for DeepSeek Harness.",
  "author": "Jesse Lai",
  "homepage": "https://github.com/Jesse-Lai/DeepSeek-Harness-Desktop-UX-First",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jesse-Lai/DeepSeek-Harness-Desktop-UX-First.git"
  },
  "bugs": {
    "url": "https://github.com/Jesse-Lai/DeepSeek-Harness-Desktop-UX-First/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "build:icon:mac": "node scripts/build-macos-icon.js",
    "build:icon:win": "node scripts/build-windows-icon.js",
    "app:dev:mac": "node scripts/create-macos-dev-app.js",
    "harness": "dsh",
    "harness:web": "dsh web",
    "licenses:check": "node scripts/generate-third-party-dependencies.js --check",
    "licenses:generate": "node scripts/generate-third-party-dependencies.js",
    "package:mac:arm64": "node scripts/package-macos-arm64.js",
    "package:mac:x64": "node scripts/package-macos-arm64.js x64",
    "package:win:x64": "node scripts/package-windows-x64.js",
    "release:verify-tag": "node scripts/verify-release-tag.js",
    "smoke:packaged:mac:arm64": "node scripts/run-packaged-smoke.js \"dist/DeepSeek Harness UX First-darwin-arm64/DeepSeek Harness UX First.app/Contents/MacOS/DeepSeek Harness UX First\"",
    "smoke:packaged:mac:x64": "node scripts/run-packaged-smoke.js \"dist/DeepSeek Harness UX First-darwin-x64/DeepSeek Harness UX First.app/Contents/MacOS/DeepSeek Harness UX First\"",
    "smoke:packaged:win:x64": "node scripts/run-packaged-smoke.js \"dist/DeepSeek Harness UX First-win32-x64/DeepSeek Harness UX First.exe\"",
    "start": "electron .",
    "test": "node --test",
    "smoke": "electron . --smoke-test",
    "verify:mac:arm64": "node scripts/verify-macos-app.js arm64",
    "verify:mac:x64": "node scripts/verify-macos-app.js x64",
    "verify:win:x64": "node scripts/verify-windows-app.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "43.4.0",
    "sharp": "0.35.3"
  }
}
