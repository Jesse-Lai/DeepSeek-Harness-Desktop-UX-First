{
  "name": "deepseek-harness-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A polished, ready-to-run desktop experience for DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "build:icon:mac": "node scripts/build-macos-icon.js",
    "app:dev:mac": "node scripts/create-macos-dev-app.js",
    "harness": "dsh",
    "harness:web": "dsh web",
    "licenses:check": "node scripts/generate-third-party-dependencies.js --check",
    "licenses:generate": "node scripts/generate-third-party-dependencies.js",
    "package:mac:arm64": "node scripts/package-macos-arm64.js",
    "package:mac:x64": "node scripts/package-macos-arm64.js x64",
    "start": "electron .",
    "test": "node --test",
    "smoke": "electron . --smoke-test"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "43.4.0",
    "sharp": "0.35.3"
  }
}
