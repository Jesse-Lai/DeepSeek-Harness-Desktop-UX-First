{
  "name": "@jesse-lai/dsh-desktop-ui",
  "version": "0.1.0",
  "description": "Jesse Agent-inspired desktop shell, sidebar and composer presentation for DeepSeek Harness.",
  "author": "Jesse Lai",
  "homepage": "https://github.com/Jesse-Lai/DeepSeek-Harness-Desktop-UX-First",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jesse-Lai/DeepSeek-Harness-Desktop-UX-First.git",
    "directory": "plugins/@jesse-lai/dsh-desktop-ui"
  },
  "bugs": {
    "url": "https://github.com/Jesse-Lai/DeepSeek-Harness-Desktop-UX-First/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./companion": "./lib/companion/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
